{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "toji:thrust",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/toji_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.35,
        "plane_normal": [
          "v.dir_x",
          "v.dir_y",
          "v.dir_z"
        ],
        "direction": [
          "v.dir_x",
          "v.dir_y",
          "v.dir_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.15, 0.3)"
      },
      "minecraft:particle_initial_speed": "math.random(14, 26)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.07,
          "0.9 * (1 - v.particle_age / v.particle_lifetime * 0.6)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity"
        },
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            64
          ],
          "uv_size": [
            8,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.7": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
