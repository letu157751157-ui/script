{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "toji:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/toji_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.15, 0.35)"
      },
      "minecraft:particle_initial_speed": "math.random(6, 10)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -8,
          0
        ],
        "linear_drag_coefficient": 5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.05,
          "0.24 * (1 - v.particle_age / v.particle_lifetime * 0.5)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity"
        },
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            24,
            96
          ],
          "uv_size": [
            4,
            12
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.7": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
