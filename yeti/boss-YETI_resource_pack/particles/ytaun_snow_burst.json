{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ytaun:snow_burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/ytaun_yeti_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "8 + v.radius * 3"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          0.3,
          0
        ],
        "radius": "0.5 + v.radius * 0.4",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + v.particle_random_1 * 0.6"
      },
      "minecraft:particle_initial_speed": "2 + v.particle_random_2 * 3 + v.radius * 0.6",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.2,
          0
        ],
        "linear_drag_coefficient": 3.5
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.5": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.35 + v.particle_random_3 * 0.35",
          "0.35 + v.particle_random_3 * 0.35"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              0,
              128
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false,
            "frames_per_second": 12
          }
        }
      }
    }
  }
}
