{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "yeti:dome_edge",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/yeti_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(90, v.radius * 5)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.radius",
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.2)"
      },
      "minecraft:particle_initial_speed": "math.random(1.5, 3)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.12,
          0.12
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              136,
              48
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "frames_per_second": 12,
            "max_frame": 2,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FF5040",
            "0.2": "#FFFF6A50",
            "0.7": "#FFC8F0FF",
            "1.0": "#00C8F0FF"
          }
        }
      }
    }
  }
}
