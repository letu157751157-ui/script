{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "yeti:warning_circle",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/yeti_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.radius",
          "v.radius"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            128,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          "0.25 + 0.75 * math.pow(v.particle_age / v.particle_lifetime, 6)",
          "0.2 + 0.8 * math.pow(v.particle_age / v.particle_lifetime, 6)",
          "math.min(1, v.particle_age / v.particle_lifetime * 6) * (0.55 + 0.45 * math.sin(v.particle_age * (400 + 900 * v.particle_age / v.particle_lifetime)))"
        ]
      }
    }
  }
}
