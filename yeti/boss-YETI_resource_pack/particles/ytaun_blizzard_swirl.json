{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ytaun:blizzard_swirl",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/ytaun_yeti_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.4
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 400) * (v.radius > 0 ? v.radius : 4) * (0.4 + v.particle_random_2 * 0.6)",
          "v.particle_age * (2 + v.particle_random_3 * 3)",
