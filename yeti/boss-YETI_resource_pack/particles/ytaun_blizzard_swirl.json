      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + v.particle_random_3 * 0.1",
          "0.12 + v.particle_random_3 * 0.1"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "64 + math.floor(v.particle_random_2 * 4) * 16",
            80
          ],
          "uv_size": [
            16,
            16
          ]
        }
      }
    }
  }
