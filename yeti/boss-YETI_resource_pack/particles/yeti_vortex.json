{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "yeti:vortex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/yeti_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 28
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.1)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 420) * v.radius * (1 - v.particle_age / v.particle_lifetime * 0.85)",
          "v.particle_random_2 * 1.5 + v.particle_age / v.particle_lifetime * 4",
          "math.sin(v.particle_random_1 * 360 + v.particle_age * 420) * v.radius * (1 - v.particle_age / v.particle_lifetime * 0.85)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.1,
          0.1
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              24,
              48
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "frames_per_second": 12,
            "max_frame": 2,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.2": "#FFFFFFFF",
            "0.8": "#FFC8F0FF",
            "1.0": "#00C8F0FF"
          }
        }
      }
    }
  }
}
