{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ytaun:ground_mist",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/ytaun_yeti_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "14 + v.radius * 4"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          0.4,
          0
        ],
        "radius": "0.4 + v.radius * 0.25",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.4 + v.particle_random_1 * 0.8"
      },
      "minecraft:particle_initial_speed": "v.radius * (1.1 + v.particle_random_2 * 0.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.4,
          0
        ],
        "linear_drag_coefficient": 1.6
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_4 * 360",
        "rotation_rate": 30
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00E6F6FF",
            "0.1": "#CCE6F6FF",
            "0.8": "#CCE6F6FF",
            "1.0": "#00E6F6FF"
          }
        }
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.7 + v.particle_age * 0.9",
          "0.7 + v.particle_age * 0.9"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              128,
              144
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false,
            "frames_per_second": 12
          }
        }
      }
    }
  }
}
