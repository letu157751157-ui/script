{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ytaun:snow_tornado",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/ytaun_yeti_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 140
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.6
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 520) * (v.radius > 0 ? v.radius : 2) * (0.3 + v.particle_age * 0.55)",
          "v.particle_age * (6 + v.particle_random_3 * 3)",
          "math.sin(v.particle_random_1 * 360 + v.particle_age * 520) * (v.radius > 0 ? v.radius : 2) * (0.3 + v.particle_age * 0.55)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_4 * 360",
        "rotation_rate": 160
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00F0FAFF",
            "0.1": "#E5F0FAFF",
            "0.8": "#E5F0FAFF",
            "1.0": "#00F0FAFF"
          }
        }
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.25 + v.particle_age * 0.35",
          "0.25 + v.particle_age * 0.35"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              0,
              128
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false,
            "frames_per_second": 12
          }
        }
      }
    }
  }
}
