{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ytaun:roar_mist",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/ytaun_yeti_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7 + v.particle_random_1 * 0.4"
      },
      "minecraft:particle_initial_speed": "3 + v.particle_random_2 * 3",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360",
        "rotation_rate": 90
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.4": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.2 + v.particle_age * 0.8",
          "0.2 + v.particle_age * 0.8"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              128,
              144
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false,
            "frames_per_second": 12
          }
        }
      }
    }
  }
}
