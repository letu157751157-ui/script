          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              136,
              48
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "frames_per_second": 12,
            "max_frame": 2,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      }
