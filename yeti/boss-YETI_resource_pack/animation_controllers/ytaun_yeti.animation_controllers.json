{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ytaun_yeti.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attack": "variable.attack_animation_tick > 0.0"
            }
          ]
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "blend_transition": 0.1,
          "transitions": [
            {
              "default": "variable.attack_animation_tick <= 0.0 && query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
