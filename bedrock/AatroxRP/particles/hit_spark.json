{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aatrox:hit_spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/aatrox_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.2, 0.4)"
      },
      "minecraft:particle_initial_speed": "math.random(5, 9)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -6,
          0
        ],
        "linear_drag_coefficient": 5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.035,
          "0.22 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity"
        },
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            16,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFF0C0",
            "0.5": "#FFFF7A28",
            "1.0": "#00C8141E"
          }
        }
      }
    }
  }
}
