{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ytaun:flies",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/ytaun_boss"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          1.5,
          0
        ],
        "radius": 1.6
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.sin(v.particle_age * 900 + v.particle_random_1 * 360) * 0.5",
          "math.sin(v.particle_age * 1300 + v.particle_random_2 * 360) * 0.25",
          "math.cos(v.particle_age * 800 + v.particle_random_3 * 360) * 0.5"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.5, 2.5)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.12,
          0.12
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 80,
          "uv": [
            48,
            48
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.1": "#FFFFFFFF",
            "0.9": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}