{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ytaun:heal_spiral",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/ytaun_boss"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 50,
        "max_particles": 100
      },
      "minecraft:emitter_lifetime_once": {
