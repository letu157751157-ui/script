{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "harvester:soul_pillar",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/harvester_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 30,
        "max_particles": 100
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.duration"
      },
      "minecraft:emitter_shape_disc": {
        "radius": 1.3,
        "plane_normal": "y",
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.6)"
      },
      "minecraft:particle_initial_speed": "math.random(2.5, 4.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.5,
          0
        ],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.25 + 0.1 * v.particle_random_2",
          "0.5 + 0.2 * v.particle_random_2"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              0,
              64
            ],
            "size_UV": [
              16,
              32
            ],
            "step_UV": [
              16,
              0
            ],
            "frames_per_second": 12,
            "max_frame": 6,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.12": "#FFFFFFFF",
            "0.7": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
