{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "harvester:blackdeath_field",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/harvester_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.radius * 9",
        "max_particles": 160
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.duration"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.radius",
        "plane_normal": "y",
        "direction": [
          0,
          1,
          0
        ],
        "offset": [
          0,
          0.3,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(2.0, 3.2)"
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.2,
          0
        ],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-25, 25)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.9 + 0.3 * v.particle_random_2",
          "0.9 + 0.3 * v.particle_random_2"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              128,
              144
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "max_frame": 4,
            "loop": false,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#001A1F14",
            "0.2": "#D01A1F14",
            "0.75": "#B0101408",
            "1.0": "#000B0E08"
          }
        }
      }
    }
  }
}
