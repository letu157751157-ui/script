{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "harvester:dancer",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/harvester_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos((v.a0 + v.particle_age * v.w)) * math.max(v.r0 - v.particle_age * v.shrink, 0)",
          "0.95 + 0.08 * math.sin(v.particle_age * 540)",
          "math.sin((v.a0 + v.particle_age * v.w)) * math.max(v.r0 - v.particle_age * v.shrink, 0)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.5,
          1.0
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              0,
              96
            ],
            "size_UV": [
              16,
              32
            ],
            "step_UV": [
              16,
              0
            ],
            "frames_per_second": 4,
            "max_frame": 2,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.08": "#FFFFFFFF",
            "0.92": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
