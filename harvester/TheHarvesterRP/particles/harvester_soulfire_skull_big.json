          "math.random(-0.25, 0.25)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.85)"
      },
      "minecraft:particle_initial_speed": "math.random(1.8, 3.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 700 + v.particle_random_3 * 360) * 1.8",
