{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "harvester:soul_wisp",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/harvester_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "math.random(-0.3, 0.3)",
          1,
          "math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.9, 1.4)"
      },
      "minecraft:particle_initial_speed": 0.8,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 0.9
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - 0.4 * v.particle_age / v.particle_lifetime)",
          "0.16 * (1 - 0.4 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              0,
              160
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 4,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.6": "#E6FFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
