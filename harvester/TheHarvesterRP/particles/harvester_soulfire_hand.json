{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "harvester:soulfire_hand",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/harvester_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 9,
        "max_particles": 16
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.16,
        "direction": [
          "math.random(-0.25, 0.25)",
          1,
          "math.random(-0.25, 0.25)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.4, 0.65)"
      },
      "minecraft:particle_initial_speed": "math.random(0.8, 1.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 700 + v.particle_random_3 * 360) * 1.4",
          2.4,
          "math.cos(v.particle_age * 640 + v.particle_random_4 * 360) * 1.4"
        ],
        "linear_drag_coefficient": 1.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.1 + 0.07 * v.particle_random_2) * (1 - 0.5 * v.particle_age / v.particle_lifetime)",
          "(0.1 + 0.07 * v.particle_random_2) * (1 - 0.5 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              48,
              96
            ],
            "size_UV": [
              16,
              16
            ],
            "step_UV": [
              16,
              0
            ],
            "frames_per_second": 14,
            "max_frame": 8,
            "loop": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.12": "#FFFFFFFF",
            "0.7": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
