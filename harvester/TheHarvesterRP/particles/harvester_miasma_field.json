{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "harvester:miasma_field",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/harvester_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.radius * 7",
        "max_particles": 90
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.duration"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.radius",
        "plane_normal": "y",
        "direction": [
          0,
          1,
          0
        ],
        "offset": [
          0,
          0.25,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(2.0, 3.0)"
      },
      "minecraft:particle_initial_speed": 0.25,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.1,
          0
        ],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-30, 30)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5 + 0.2 * v.particle_random_2",
          "0.5 + 0.2 * v.particle_random_2"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "flipbook": {
            "base_UV": [
              80,
              32
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              8,
              0
            ],
            "max_frame": 8,
            "loop": false,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00A8C94A",
            "0.15": "#B08DB33A",
            "0.7": "#8C6E8F2A",
            "1.0": "#003F5A17"
          }
        }
      }
    }
  }
}
